{
    "version": 2,
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/server.ts"
        }
    ],
    "functions": {
        "src/server.ts": {
            "maxDuration": 10
        }
    },
    "env": {
        "NODE_ENV": "production"
    },
    "build": {
        "env": {
            "NODE_ENV": "production"
        }
    },
    "cleanUrls": true,
    "trailingSlash": false
}
